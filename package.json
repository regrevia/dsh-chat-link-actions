{
  "name": "dsh-chat-link-actions",
  "version": "0.6.14",
  "description": "Right-click any attachment or path in the DSH transcript and hand it to your own action: send it to a WeChat contact, open it in Chrome, or whatever you configure. One right-click, any entry point; menus are drawn in the app's own style, never the system one.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "PROTOCOL.md",
    "README.md",
    "cli.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "index.js",
    "protocol.json",
    "AGENTS.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "link-actions",
    "file-link",
    "quote-path",
    "reveal-in-finder"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-chat-link-actions.git"
  },
  "homepage": "https://github.com/regrevia/dsh-chat-link-actions#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-chat-link-actions/issues"
  },
  "scripts": {
    "test": "node --test test/index.test.js test/client-paths.test.js test/client-targets.test.js test/client-menu.test.js test/client-correctness.test.js test/windows-shell.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check cli.js",
    "win:test": "node scripts/win-node.mjs test",
    "win:info": "node scripts/win-node.mjs info",
    "win:pwsh": "node scripts/win-node.mjs pwsh"
  },
  "bin": {
    "dsh-chat-link-actions": "./cli.js"
  }
}
